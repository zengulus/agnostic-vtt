{
  "name": "aether-table",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build": "npm run build:web && tsc -p tsconfig.server.json",
    "build:web": "npm run typecheck && vite build",
    "test:pages": "node scripts/verify-pages.mjs",
    "review:visuals": "node scripts/capture-visuals.mjs",
    "start": "node --env-file-if-exists=.env dist-server/server/index.js",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write src shared server tests *.ts *.json *.md docs .github/workflows render.yaml",
    "test:hosted": "tsx scripts/verify-hosted.mjs"
  },
  "dependencies": {
    "@3d-dice/dice-box-threejs": "^0.0.12",
    "@supabase/supabase-js": "^2.80.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5",
    "ws": "^8.18.0",
    "zod": "^3.24.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.1.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "^6.1.0",
    "vitest": "^5.0.4"
  }
}
