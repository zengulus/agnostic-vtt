# Local mode works with no credentials. Never enable local auth on a public deployment.
AUTH_MODE=local
PORT=3001
HOST=127.0.0.1
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SNAPSHOT_INTERVAL_MS=90000
PERSIST_DEBOUNCE_MS=5000
LOCAL_DATA_DIR=.data
# Production: set AUTH_MODE=supabase and provide these on Render only.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
# Supabase public settings for the frontend (safe public anon/publishable key).
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=public-anon-key
# VITE_SERVER_URL=https://your-service.onrender.com
# VITE_BASE_PATH=/agnostic-vtt/
